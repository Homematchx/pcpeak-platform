# SQLite DB files never belong in git — pcpeak.db (scraped) AND ledger.db (prod-owned
# prediction_ledger/rep_actions). data/db/dump.sql (tracked snapshot) is unaffected (.sql).
data/db/*.db
data/db/*.db-shm
data/db/*.db-wal

# Installer artifacts should never land in the repo (e.g. accidental 310MB Claude.dmg)
*.dmg

# Secrets — never commit API keys (any file ending in .env, dotfiles, etc.)
.env
*.env
.env.*
!.env.example

# Python bytecode
*.pyc
__pycache__/

# Scraped source corpus — the petition/docket raw files live on disk (and belong in
# the durable object-store archive, see archive.py), NOT in git. ~237MB; keeps the
# repo lean. PDFs anywhere are ignored to catch stray downloads too.
data/pdfs/
*.pdf
