# PC Peak Platform — Environment Variables
# Copy this to .env and fill in your keys

# REQUIRED: Get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OPTIONAL: Get from 2captcha.com for fully automated CAPTCHA solving (~$3/1000)
TWO_CAPTCHA_KEY=your-2captcha-key-here

# RAW-CAPTURE ARCHIVE (durable S3-compatible object storage — Cloudflare R2 / Backblaze B2 / AWS S3)
# When all four are set, every scrape uploads the raw petition PDF + docket +
# extraction/enrichment snapshots (timestamped, append-only) and prunes the local
# PDF. Unset = archiving off, scraper behaves as before. Verify with: python3 archive.py
# ARCHIVE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# ARCHIVE_BUCKET=pcpeak-raw
# ARCHIVE_ACCESS_KEY_ID=...
# ARCHIVE_SECRET_ACCESS_KEY=...
# ARCHIVE_REGION=auto

# OPTIONAL: Email notifications when cases update
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password
# NOTIFY_EMAIL=stephen@pcpeak.com
